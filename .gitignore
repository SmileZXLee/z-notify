# OS files
.DS_Store
Thumbs.db
*.db

# IDEs and Editors
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.iml
*.ipr
*.iws

# Build outputs and dependency directories in sub-projects
**/node_modules/
**/dist/
**/target/
**/build/
**/out/

# Package outputs (Java jars, wars, ears, zips, tar.gz)
*.jar
*.war
*.ear
*.zip
*.tar.gz
# Exclude maven-wrapper.jar from being ignored so mvnw works
!**/maven-wrapper.jar

# Log files
*.log
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*
**/pnpm-debug.log*

# Local env files
**/.env.local
**/.env.*.local

# Temp files
.tmp/
.temp/
